{% doc %}
  Fit checker. Car data comes from metaobject entries of type "car_model":
  make, model, fit_status ("Fits", "Small gap" or "Ask us"), note (optional).
  With no entries yet, shoppers type their car and go to WhatsApp.

  @param {string} id - unique id for labels
  @param {string} [title] - small heading above the fields
  @param {product} [product] - adds the product title to the WhatsApp message
  @param {string} [fits_text] - result headline when it fits; {car} is replaced
  @param {string} [gap_text] - result headline for a small gap
  @param {string} [ask_text] - result headline when not measured
  @param {string} [no_text] - result headline when the car is not suitable
  @param {string} [fit_note] - edition-specific fit note shown above the fields
{% enddoc %}
{%- liquid
  assign wa_number = settings.whatsapp_number | remove: ' ' | remove: '+' | remove: '-'
  assign wa_message = settings.whatsapp_message
  if product
    assign wa_message = wa_message | append: ' (' | append: product.title | append: ')'
  endif
  assign fits_text = fits_text | default: 'Fits your {car}'
  assign gap_text = gap_text | default: 'Fits your {car} with a small gap at the edges'
  assign ask_text = ask_text | default: "We haven't measured the {car} yet — ask us and we'll check"
  assign no_text = no_text | default: 'Not suitable for your {car}' 
-%}
<fk-fit-check
  class="fit"
  data-wa-number="{{ wa_number | escape }}"
  data-wa-message="{{ wa_message | escape }}"
  data-fits-text="{{ fits_text | escape }}"
  data-gap-text="{{ gap_text | escape }}"
  data-ask-text="{{ ask_text | escape }}"
  data-no-text="{{ no_text | escape }}"
>
  {%- if title != blank -%}
    <p class="fit__title">{{ title | escape }}</p>
  {%- endif -%}

  {%- if fit_note != blank -%}
    <p class="fit__note">{% render 'icon', name: 'ruler' %}<span>{{ fit_note | escape }}</span></p>
  {%- endif -%}

  {%- assign car_count = 0 -%}
  {%- capture car_json -%}
    {%- paginate shop.metaobjects.car_model.values by 250 -%}
      {%- for car in shop.metaobjects.car_model.values -%}
        {%- if car_count > 0 -%},{%- endif -%}
        {"make":{{ car.make.value | json }},"model":{{ car.model.value | json }},"status":{{ car.fit_status.value | json }},"note":{{ car.note.value | json }}}
        {%- assign car_count = car_count | plus: 1 -%}
      {%- endfor -%}
    {%- endpaginate -%}
  {%- endcapture -%}
  {%- if car_count > 0 -%}
    <script type="application/json" data-fk-cars>[{{ car_json }}]</script>
    <div class="fit__fields">
      <div class="field">
        <label for="FitMake-{{ id }}">Make</label>
        <select class="select" id="FitMake-{{ id }}" data-fk-make>
          <option value="">Select make</option>
        </select>
      </div>
      <div class="field">
        <label for="FitModel-{{ id }}">Model</label>
        <select class="select" id="FitModel-{{ id }}" data-fk-model disabled>
          <option value="">Select model</option>
        </select>
      </div>
    </div>
  {%- else -%}
    <div class="fit__fields">
      <div class="field">
        <label for="FitCar-{{ id }}">Your car (make and model)</label>
        <input class="input" id="FitCar-{{ id }}" type="text" autocomplete="off" placeholder="e.g. Hyundai Creta" data-fk-car-text>
      </div>
    </div>
  {%- endif -%}

  <p class="fit__result" role="status" aria-live="polite" data-fk-result hidden></p>

  {%- if wa_number != blank -%}
    <a class="button button--outline button--small fit__wa" href="https://wa.me/{{ wa_number }}?text={{ wa_message | url_encode }}" target="_blank" rel="noopener" data-fk-wa data-fk-track="whatsapp_click">
      {%- render 'icon', name: 'whatsapp' -%}
      Ask on WhatsApp
    </a>
  {%- endif -%}
</fk-fit-check>
