{%- liquid
  assign ig_url = section.settings.url | default: settings.instagram_url
  assign has_app = false
  for block in section.blocks
    if block.type == '@app'
      assign has_app = true
    endif
  endfor
-%}
{%- if has_app or request.design_mode -%}
<section {% render 'section-attrs', section: section, class: 'ig-feed' %}>
  <div class="page-width stack" style="--gap: 2.8rem">
    <div class="section-head">
      <div class="stack" style="--gap: 0.8rem">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="h2">{{ section.settings.heading | escape }}</h2>
      </div>
      {%- if ig_url != blank -%}
        <a class="button button--outline" href="{{ ig_url }}" target="_blank" rel="noopener" data-fk-track="instagram_click">
          {%- render 'icon', name: 'instagram' -%}
          {{ section.settings.button | escape }}
        </a>
      {%- endif -%}
    </div>
    {%- if has_app -%}
      <div class="ig-feed__app">
        {%- for block in section.blocks -%}
          {%- if block.type == '@app' -%}{% render block %}{%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="ig-feed__empty muted">
        Install an Instagram feed app (for example Instafeed by Mintt, free), connect @{{ section.settings.handle | escape }}, then add its block to this section. This message only shows in the theme editor.
      </p>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Instagram feed",
  "settings": [
    { "type": "paragraph", "content": "Shows your latest Instagram posts and reels through an Instagram feed app block. Hidden on the store until an app block is added." },
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "@fuelkicks.com__" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Fresh from Instagram" },
    { "type": "text", "id": "handle", "label": "Instagram handle", "default": "fuelkicks.com__" },
    { "type": "url", "id": "url", "label": "Profile link", "info": "Defaults to Theme settings › Contact › Instagram link." },
    { "type": "text", "id": "button", "label": "Button label", "default": "Follow on Instagram" },
    {"type": "header", "content": "Section style"},
    {"type": "select", "id": "scheme", "label": "Colors", "options": [{"value": "dark", "label": "Ink"}, {"value": "carbon", "label": "Carbon"}, {"value": "light", "label": "Light"}, {"value": "white", "label": "White"}, {"value": "accent", "label": "Lime"}], "default": "carbon"},
    {"type": "checkbox", "id": "border", "label": "Top border", "default": true},
    {"type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72},
    {"type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72}
  ],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "Instagram feed" }]
}
{% endschema %}
