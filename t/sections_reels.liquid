<section {% render 'section-attrs', section: section, class: 'reels' %}>
  <div class="page-width stack" style="--gap: 2.8rem">
    <div class="section-head">
      <div class="stack" style="--gap: 0.8rem">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="h2">{{ section.settings.heading | escape }}</h2>
      </div>
      {%- if section.settings.link_label != blank and section.settings.link != blank -%}
        <a class="link-arrow" href="{{ section.settings.link }}" target="_blank" rel="noopener">{{ section.settings.link_label | escape }} →</a>
      {%- endif -%}
    </div>
    <ul class="reels__track" role="list">
      {%- for block in section.blocks -%}
        {%- assign shop_product = block.settings.product -%}
        <li class="reel{% if block.type == '@app' %} reel--app{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.type == '@app' -%}
            {% render block %}
          {%- else -%}
          <div class="reel__media">
            {%- if block.settings.video != blank -%}
              {{ block.settings.video | video_tag: muted: true, loop: true, playsinline: true, controls: false, preload: 'metadata', image_size: '540x', data-fk-autoplay: '' }}
            {%- elsif block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 990px) 20vw, 60vw', alt: block.settings.car }}
            {%- else -%}
              <span class="reel__ph">Reel 9:16</span>
            {%- endif -%}
          </div>
          <div class="reel__body">
            {%- if block.settings.car != blank -%}<strong>{{ block.settings.car | escape }}</strong>{%- endif -%}
            {%- if shop_product != blank -%}
              <span class="small">{{ shop_product.title | escape }}</span>
              <a class="button button--small" href="{{ shop_product.url }}">Shop this look</a>
            {%- endif -%}
          </div>
          {%- if block.settings.post_url != blank -%}
            <a class="reel__ig" href="{{ block.settings.post_url }}" target="_blank" rel="noopener" aria-label="Watch on Instagram">{% render 'icon', name: 'instagram' %}</a>
          {%- endif -%}
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
    {%- if section.settings.note != blank -%}<p class="small muted">{{ section.settings.note | escape }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Owner reels",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "#DriveInStyle" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Owners' cabins" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Share your setup" },
    { "type": "url", "id": "link", "label": "Link", "info": "e.g. your Instagram profile" },
    { "type": "text", "id": "note", "label": "Note" },
    {"type": "header", "content": "Section style"},
    {"type": "select", "id": "scheme", "label": "Colors", "options": [{"value": "dark", "label": "Ink"}, {"value": "carbon", "label": "Carbon"}, {"value": "light", "label": "Light"}, {"value": "white", "label": "White"}, {"value": "accent", "label": "Lime"}], "default": "dark"},
    {"type": "checkbox", "id": "border", "label": "Top border", "default": false},
    {"type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72},
    {"type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72}
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "Reel",
      "settings": [
        { "type": "video", "id": "video", "label": "Video (9:16)" },
        { "type": "image_picker", "id": "image", "label": "Image (9:16)", "info": "Used when there is no video." },
        { "type": "text", "id": "car", "label": "Car model", "info": "Only post owners' photos with their permission." },
        { "type": "product", "id": "product", "label": "Edition shown" },
        { "type": "url", "id": "post_url", "label": "Instagram post link", "info": "Adds an Instagram button on the reel." }
      ]
    },
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "Owner reels",
      "blocks": [{ "type": "reel" }, { "type": "reel" }, { "type": "reel" }, { "type": "reel" }]
    }
  ]
}
{% endschema %}
