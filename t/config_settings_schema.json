[
  {
    "name": "theme_info",
    "theme_name": "Fuel Kicks",
    "theme_version": "1.0.0",
    "theme_author": "Fuel Kicks",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo (light, for dark backgrounds)",
        "info": "Leave empty to use the bundled Fuel Kicks logo."
      },
      {
        "type": "range",
        "id": "logo_height",
        "min": 16,
        "max": 48,
        "step": 2,
        "unit": "px",
        "label": "Logo height",
        "default": 26
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Leave empty to use the bundled mark."
      },
      {
        "type": "image_picker",
        "id": "share_image",
        "label": "Social sharing image",
        "info": "Shown when a link to the store is shared and the page has no image of its own. 1200 × 630 px."
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_ink",
        "label": "Ink (dark background)",
        "default": "#0D0D0D"
      },
      {
        "type": "color",
        "id": "color_carbon",
        "label": "Carbon (cards on dark)",
        "default": "#1A1A1A"
      },
      {
        "type": "color",
        "id": "color_line",
        "label": "Lines on dark",
        "default": "#2B2B2B"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent (Fuel Lime)",
        "default": "#A3FD00"
      },
      {
        "type": "color",
        "id": "color_light",
        "label": "Light background",
        "default": "#F5F5F0"
      },
      {
        "type": "color",
        "id": "color_alert",
        "label": "Alert / sold out",
        "default": "#E5484D"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "select",
        "id": "page_width",
        "label": "Page width",
        "options": [
          {
            "value": "1200px",
            "label": "Narrow"
          },
          {
            "value": "1280px",
            "label": "Standard"
          },
          {
            "value": "1440px",
            "label": "Wide"
          }
        ],
        "default": "1280px"
      },
      {
        "type": "checkbox",
        "id": "reduce_motion",
        "label": "Turn off decorative motion",
        "default": false
      }
    ]
  },
  {
    "name": "Contact",
    "settings": [
      {
        "type": "text",
        "id": "whatsapp_number",
        "label": "WhatsApp number",
        "info": "Country code + number, digits only, e.g. 919876543210. Leave blank to hide WhatsApp buttons."
      },
      {
        "type": "text",
        "id": "whatsapp_message",
        "label": "WhatsApp opening message",
        "default": "Hi Fuel Kicks, will your mats fit my car?"
      },
      {
        "type": "text",
        "id": "support_hours",
        "label": "Support hours",
        "default": "Mon–Sat, 10 am – 7 pm"
      },
      {
        "type": "text",
        "id": "instagram_url",
        "label": "Instagram link"
      },
      {
        "type": "text",
        "id": "youtube_url",
        "label": "YouTube link"
      }
    ]
  },
  {
    "name": "Delivery and payments",
    "settings": [
      {
        "type": "text",
        "id": "dispatch_text",
        "label": "Dispatch time",
        "default": "1–3 days"
      },
      {
        "type": "range",
        "id": "delivery_min_days",
        "label": "Delivery estimate from (days after order)",
        "min": 1,
        "max": 15,
        "step": 1,
        "default": 5
      },
      {
        "type": "range",
        "id": "delivery_max_days",
        "label": "Delivery estimate to (days after order)",
        "min": 1,
        "max": 20,
        "step": 1,
        "default": 7
      },
      {
        "type": "number",
        "id": "prepaid_saving",
        "label": "UPI / card saving (₹)",
        "info": "Shown on product pages, the cart and the sticky bar. 0 hides it. Set up the discount itself in your payment gateway or checkout app first."
      },
      {
        "type": "text",
        "id": "payment_text",
        "label": "Payment methods line",
        "default": "UPI · Cards · Cash on delivery"
      },
      {
        "type": "text",
        "id": "returns_text",
        "label": "Returns line",
        "default": "7-day returns"
      }
    ]
  },
  {
    "name": "Mat sizes",
    "settings": [
      {
        "type": "text",
        "id": "front_size",
        "label": "Front mat size",
        "default": "68 × 50 cm"
      },
      {
        "type": "text",
        "id": "rear_size",
        "label": "Rear mat size",
        "default": "43 × 48 cm"
      },
      {
        "type": "text",
        "id": "rear_top",
        "label": "Rear mat top width",
        "default": "36 cm"
      },
      {
        "type": "textarea",
        "id": "fit_rule",
        "label": "Fit rule",
        "info": "Shown in the fit checker, size section and size guide.",
        "default": "Universal fit for most hatchbacks, sedans, SUVs and MPVs. If your front footwell floor is at least 68 × 50 cm and the rear is at least 48 cm wide, the set fits."
      },
      {
        "type": "text",
        "id": "set_contents",
        "label": "Set contents",
        "default": "2 front + 2 rear mats"
      }
    ]
  },
  {
    "name": "Cart",
    "settings": [
      {
        "type": "checkbox",
        "id": "cart_drawer",
        "label": "Open a cart drawer after adding",
        "default": true
      },
      {
        "type": "range",
        "id": "bundle_qty",
        "label": "Sets needed for the multi-set offer",
        "min": 2,
        "max": 4,
        "step": 1,
        "default": 2
      },
      {
        "type": "text",
        "id": "bundle_reward",
        "label": "Multi-set reward text",
        "info": "e.g. ₹300 off or a free gift. Leave blank to hide the progress bar. Create the matching automatic discount in Discounts first."
      },
      {
        "type": "collection",
        "id": "cart_upsell_collection",
        "label": "Suggest from this collection in the cart"
      },
      {
        "type": "checkbox",
        "id": "cart_fit_reminder",
        "label": "Show fit reminder in the cart",
        "default": true
      }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "header",
        "content": "Look"
      },
      {
        "type": "select",
        "id": "card_style",
        "label": "Card style",
        "options": [
          {
            "value": "plain",
            "label": "Plain"
          },
          {
            "value": "boxed",
            "label": "Boxed"
          }
        ],
        "default": "plain"
      },
      {
        "type": "select",
        "id": "card_ratio",
        "label": "Image shape",
        "options": [
          {
            "value": "square",
            "label": "Square"
          },
          {
            "value": "portrait",
            "label": "Portrait 4:5"
          },
          {
            "value": "landscape",
            "label": "Landscape 4:3"
          }
        ],
        "default": "square"
      },
      {
        "type": "select",
        "id": "card_fit",
        "label": "Image fit",
        "options": [
          {
            "value": "contain",
            "label": "Show whole image"
          },
          {
            "value": "cover",
            "label": "Fill the frame"
          }
        ],
        "default": "contain"
      },
      {
        "type": "select",
        "id": "card_hover",
        "label": "On hover",
        "options": [
          {
            "value": "second",
            "label": "Show second image"
          },
          {
            "value": "zoom",
            "label": "Zoom image"
          },
          {
            "value": "none",
            "label": "Nothing"
          }
        ],
        "default": "second",
        "info": "Second image is the product's 2nd photo, e.g. the mats installed."
      },
      {
        "type": "checkbox",
        "id": "card_show_number",
        "label": "Show edition number",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "card_show_theme",
        "label": "Show theme label",
        "info": "From product metafield custom.theme or the product type.",
        "default": true
      },
      {
        "type": "text",
        "id": "card_quick_add_label",
        "label": "Quick add button label",
        "default": "Quick add"
      },
      {
        "type": "header",
        "content": "Badges"
      },
      {
        "type": "select",
        "id": "card_badge_style",
        "label": "Badge style",
        "options": [
          {
            "value": "lime",
            "label": "Lime"
          },
          {
            "value": "ink",
            "label": "Ink"
          },
          {
            "value": "outline",
            "label": "Outline"
          }
        ],
        "default": "lime"
      },
      {
        "type": "checkbox",
        "id": "card_stock_badge",
        "label": "Show 'In stock' badge",
        "default": true
      },
      {
        "type": "range",
        "id": "card_low_stock",
        "label": "Show 'Only X left' at or below",
        "info": "0 turns it off. Uses real inventory only.",
        "min": 0,
        "max": 10,
        "step": 1,
        "default": 0
      },
      {
        "type": "checkbox",
        "id": "card_sale_badge",
        "label": "Show % off badge on the image",
        "default": false
      },
      {
        "type": "text",
        "id": "card_tag_badges",
        "label": "Product tags shown as badges",
        "info": "Comma separated, e.g. new, bestseller, limited. Add the same tag to a product to show it.",
        "default": "new, bestseller, limited"
      },
      {
        "type": "header",
        "content": "Other"
      },
      {
        "type": "text",
        "id": "drop_label",
        "label": "Default drop label",
        "info": "Used when a product has no custom.drop_number metafield.",
        "default": "Drop 01"
      },
      {
        "type": "checkbox",
        "id": "show_discount_percent",
        "label": "Show % off when a compare-at price is set",
        "default": true
      }
    ]
  }
]