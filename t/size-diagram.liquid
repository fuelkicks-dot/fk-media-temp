{% doc %}
  Front and rear mat dimension diagram drawn to the real mat outlines (1 cm = 4 units).
  Labels come from Theme settings › Mat sizes ("height × width cm").
  Animates in when scrolled into view (theme.js, [data-fk-draw]).
{% enddoc %}
{%- liquid
  assign f = settings.front_size | remove: 'cm' | split: '×'
  assign r = settings.rear_size | remove: 'cm' | split: '×'
  assign f_h = f[0] | strip | append: ' cm'
  assign f_w = f[1] | strip | append: ' cm'
  assign r_h = r[0] | strip | append: ' cm'
  assign r_w = r[1] | strip | append: ' cm'
-%}
<svg class="size-diagram" viewBox="0 0 560 384" role="img" data-fk-draw aria-label="Front mats {{ settings.front_size }}, two pieces; rear mats {{ settings.rear_size }} with a {{ settings.rear_top }} top, two pieces">
  {%- comment -%} Front mat {%- endcomment -%}
  <g class="size-diagram__mat" transform="translate(48 40)">
    <path d="M36 0H164Q178 0 178 14L176 56C175 80 180 96 188 112C198 132 200 148 200 168V252Q200 272 180 272H20Q0 272 0 252V168C0 148 2 132 12 112C20 96 25 80 24 56L22 14Q22 0 36 0Z" class="size-diagram__fill"/>
    <path d="M36 0H164Q178 0 178 14L176 56C175 80 180 96 188 112C198 132 200 148 200 168V252Q200 272 180 272H20Q0 272 0 252V168C0 148 2 132 12 112C20 96 25 80 24 56L22 14Q22 0 36 0Z" class="size-diagram__edge" pathLength="1"/>
    <rect x="166" y="210" width="10" height="34" class="size-diagram__tag"/>
    <text x="100" y="150" class="size-diagram__name">FRONT ×2</text>
  </g>

  {%- comment -%} Rear mat {%- endcomment -%}
  <g class="size-diagram__mat size-diagram__mat--rear" transform="translate(312 140)">
    <path d="M40 0H152Q168 0 168 16V40C168 50 172 54 180 60C190 68 192 74 192 84V156Q192 172 176 172H16Q0 172 0 156V84C0 74 2 68 12 60C20 54 24 50 24 40V16Q24 0 40 0Z" class="size-diagram__fill"/>
    <path d="M40 0H152Q168 0 168 16V40C168 50 172 54 180 60C190 68 192 74 192 84V156Q192 172 176 172H16Q0 172 0 156V84C0 74 2 68 12 60C20 54 24 50 24 40V16Q24 0 40 0Z" class="size-diagram__edge" pathLength="1"/>
    <rect x="160" y="118" width="10" height="34" class="size-diagram__tag"/>
    <text x="96" y="110" class="size-diagram__name">REAR ×2</text>
  </g>

  <g class="size-diagram__dims" stroke="currentColor" stroke-width="1.5" fill="none">
    <g class="size-diagram__dim size-diagram__dim--x"><path d="M48 334H248M48 326v16M248 326v16"/></g>
    <g class="size-diagram__dim size-diagram__dim--y"><path d="M24 40V312M16 40h16M16 312h16"/></g>
    <g class="size-diagram__dim size-diagram__dim--x"><path d="M336 120H480M336 112v16M480 112v16"/></g>
    <g class="size-diagram__dim size-diagram__dim--x"><path d="M312 334H504M312 326v16M504 326v16"/></g>
    <g class="size-diagram__dim size-diagram__dim--y"><path d="M528 140V312M520 140h16M520 312h16"/></g>
  </g>

  <g class="size-diagram__labels" fill="currentColor" text-anchor="middle">
    <text x="148" y="364">{{ f_w }}</text>
    <text x="14" y="176" transform="rotate(-90 14 176)">{{ f_h }}</text>
    <text x="408" y="106">{{ settings.rear_top }}</text>
    <text x="408" y="364">{{ r_w }}</text>
    <text x="550" y="226" transform="rotate(90 550 226)">{{ r_h }}</text>
  </g>
</svg>
