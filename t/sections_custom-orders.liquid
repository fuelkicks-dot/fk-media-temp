{%- assign wa_number = settings.whatsapp_number | remove: ' ' | remove: '+' | remove: '-' -%}
<section {% render 'section-attrs', section: section, class: 'custom-orders' %}>
  <div class="page-width custom-orders__grid">
    <div class="stack" style="--gap: 2.4rem">
      <div class="stack" style="--gap: 1.2rem">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="h2">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}<div class="lead rte">{{ section.settings.text }}</div>{%- endif -%}
      </div>

      {%- assign points = section.blocks | where: 'type', 'point' -%}
      {%- if points.size > 0 -%}
        <ul class="custom-orders__points" role="list">
          {%- for block in points -%}
            <li {{ block.shopify_attributes }}>{% render 'icon', name: 'check' %}<span>{{ block.settings.text | escape }}</span></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- if block.type == 'collab' -%}
          <div class="collab" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <div class="collab__media">
                {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450, 900', sizes: '(min-width: 990px) 40vw, 100vw', alt: block.settings.title }}
              </div>
            {%- endif -%}
            <div class="collab__body">
              <p class="eyebrow">{{ block.settings.label | escape }}</p>
              <p class="collab__title">
                {%- if block.settings.logo != blank -%}
                  {{ block.settings.logo | image_url: height: 80 | image_tag: alt: block.settings.title, class: 'collab__logo' }}
                {%- else -%}
                  {{ block.settings.title | escape }}
                {%- endif -%}
              </p>
              {%- if block.settings.text != blank -%}<p class="small">{{ block.settings.text | escape }}</p>{%- endif -%}
              {%- if block.settings.link != blank -%}
                <a class="link-arrow" href="{{ block.settings.link }}" target="_blank" rel="noopener">{{ block.settings.link_label | default: 'Visit' | escape }} →</a>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="custom-orders__form-wrap">
      {%- form 'contact', id: 'CustomOrderForm', class: 'custom-orders__form' -%}
        <input type="hidden" name="contact[Enquiry]" value="Custom / bulk order">
        <input type="hidden" name="contact[tags]" value="custom-bulk">
        {%- if form.posted_successfully? -%}
          <p class="form-message form-message--success" role="status">Thanks — we've got your enquiry and will reply on WhatsApp or email shortly.</p>
        {%- else -%}
          <p class="h3">{{ section.settings.form_heading | escape }}</p>
          {%- if form.errors -%}<p class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
          <div class="custom-orders__fields">
            <div class="field">
              <label for="CO-name-{{ section.id }}">Name</label>
              <input class="input" id="CO-name-{{ section.id }}" type="text" name="contact[name]" autocomplete="name" required>
            </div>
            <div class="field">
              <label for="CO-company-{{ section.id }}">Business / club</label>
              <input class="input" id="CO-company-{{ section.id }}" type="text" name="contact[Business]" autocomplete="organization">
            </div>
            <div class="field">
              <label for="CO-phone-{{ section.id }}">Phone / WhatsApp</label>
              <input class="input" id="CO-phone-{{ section.id }}" type="tel" name="contact[phone]" autocomplete="tel" required>
            </div>
            <div class="field">
              <label for="CO-email-{{ section.id }}">Email</label>
              <input class="input" id="CO-email-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" required>
            </div>
            <div class="field">
              <label for="CO-qty-{{ section.id }}">Quantity (sets)</label>
              <select class="select" id="CO-qty-{{ section.id }}" name="contact[Quantity]">
                <option>10–25</option>
                <option>25–50</option>
                <option>50–100</option>
                <option>100+</option>
              </select>
            </div>
            <div class="field">
              <label for="CO-cars-{{ section.id }}">Car models</label>
              <input class="input" id="CO-cars-{{ section.id }}" type="text" name="contact[Car models]" placeholder="e.g. mixed, mostly SUVs">
            </div>
            <div class="field field--full">
              <label for="CO-msg-{{ section.id }}">Your idea</label>
              <textarea class="input" id="CO-msg-{{ section.id }}" name="contact[body]" rows="4" placeholder="Logo, colours, occasion, deadline…"></textarea>
            </div>
          </div>
          <button type="submit" class="button button--full">{{ section.settings.button | escape }}</button>
          {%- if wa_number != blank -%}
            <a class="button button--outline button--full" href="https://wa.me/{{ wa_number }}?text={{ section.settings.wa_message | url_encode }}" target="_blank" rel="noopener" data-fk-track="whatsapp_click">
              {%- render 'icon', name: 'whatsapp' -%}
              Or message us on WhatsApp
            </a>
          {%- endif -%}
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom & bulk orders",
  "max_blocks": 8,
  "settings": [
    { "type": "paragraph", "content": "Form submissions arrive in your store email and are tagged custom-bulk." },
    { "type": "text", "id": "eyebrow", "label": "Label", "default": "Custom & bulk orders" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your brand, under every driver's feet." },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Custom-printed car mats in bulk for dealerships, showrooms, rental fleets, car clubs and corporate gifts. Send us your logo or idea and the quantity, and we'll come back with options and a quote.</p>" },
    { "type": "text", "id": "form_heading", "label": "Form heading", "default": "Tell us what you need" },
    { "type": "text", "id": "button", "label": "Button", "default": "Get a quote" },
    { "type": "text", "id": "wa_message", "label": "WhatsApp message", "default": "Hi Fuel Kicks, I'd like a quote for custom car mats in bulk." },
    {"type": "header", "content": "Section style"},
    {"type": "select", "id": "scheme", "label": "Colors", "options": [{"value": "dark", "label": "Ink"}, {"value": "carbon", "label": "Carbon"}, {"value": "light", "label": "Light"}, {"value": "white", "label": "White"}, {"value": "accent", "label": "Lime"}], "default": "carbon"},
    {"type": "checkbox", "id": "border", "label": "Top border", "default": true},
    {"type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72},
    {"type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72}
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Your logo or artwork, printed edge to edge" }]
    },
    {
      "type": "collab",
      "name": "Collab / client",
      "limit": 2,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Recent collab" },
        { "type": "text", "id": "title", "label": "Client name", "default": "Royal Drive" },
        { "type": "image_picker", "id": "logo", "label": "Client logo", "info": "Only with the client's permission." },
        { "type": "image_picker", "id": "image", "label": "Photo of the custom mats" },
        { "type": "text", "id": "text", "label": "Text" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "royaldrive.in" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom & bulk orders",
      "blocks": [{ "type": "point" }, { "type": "collab" }]
    }
  ]
}
{% endschema %}
