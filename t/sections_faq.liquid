{%- assign wa_number = settings.whatsapp_number | remove: ' ' | remove: '+' | remove: '-' -%}
{%- if section.blocks.size > 0 -%}
  <section {% render 'section-attrs', section: section, class: 'faq' %}>
    <div class="page-width faq__grid">
      <div class="stack" style="--gap: 1.6rem">
        <h2 class="h2">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}<p class="muted">{{ section.settings.text | escape }}{% if settings.support_hours != blank %} {{ settings.support_hours | escape }}.{% endif %}</p>{%- endif -%}
        {%- if wa_number != blank -%}
          <a class="button" style="align-self: flex-start" href="https://wa.me/{{ wa_number }}?text={{ settings.whatsapp_message | url_encode }}" target="_blank" rel="noopener" data-fk-track="whatsapp_click">
            {%- render 'icon', name: 'whatsapp' -%}
            Chat on WhatsApp
          </a>
        {%- endif -%}
      </div>
      <div class="faq__list">
        {%- for block in section.blocks -%}
          <details class="accordion" {{ block.shopify_attributes }}>
            <summary>{{ block.settings.question | escape }}{% render 'icon', name: 'plus' %}</summary>
            <div class="accordion__body rte">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
    </div>
    {%- if section.settings.schema_markup -%}
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          "mainEntity": [
            {%- for block in section.blocks -%}
              {
                "@type": "Question",
                "name": {{ block.settings.question | json }},
                "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
              }{% unless forloop.last %},{% endunless %}
            {%- endfor -%}
          ]
        }
      </script>
    {%- endif -%}
  </section>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "max_blocks": 20,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions" },
    { "type": "text", "id": "text", "label": "Text", "default": "Real people on WhatsApp." },
    { "type": "checkbox", "id": "schema_markup", "label": "Add FAQ structured data for Google", "info": "Use on one page only.", "default": false },
    {"type": "header", "content": "Section style"},
    {"type": "select", "id": "scheme", "label": "Colors", "options": [{"value": "dark", "label": "Ink"}, {"value": "carbon", "label": "Carbon"}, {"value": "light", "label": "Light"}, {"value": "white", "label": "White"}, {"value": "accent", "label": "Lime"}], "default": "dark"},
    {"type": "checkbox", "id": "border", "label": "Top border", "default": false},
    {"type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72},
    {"type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72}
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Will it fit my car?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Use the fit checker, or send your car model on WhatsApp and we'll confirm before you order.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "question", "settings": { "question": "Will it fit my car?", "answer": "<p>Use the fit checker, or send your car model on WhatsApp and we'll confirm before you order.</p>" } },
        { "type": "question", "settings": { "question": "How long does delivery take?", "answer": "<p>We dispatch within 24 hours, and delivery takes 5–7 days across India.</p>" } }
      ]
    }
  ]
}
{% endschema %}
