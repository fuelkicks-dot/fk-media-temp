{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign saving = settings.prepaid_saving | default: 0 | times: 100
  assign media_count = product.media.size
  assign form_id = 'ProductForm-' | append: section.id
-%}
<section class="product scheme-dark" aria-label="{{ product.title | escape }}">
  <div class="page-width">
    <nav class="breadcrumb small" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span aria-hidden="true">/</span>
      {%- if collection -%}
        <a href="{{ collection.url }}">{{ collection.title | escape }}</a>
      {%- else -%}
        <a href="{{ routes.all_products_collection_url }}">Shop editions</a>
      {%- endif -%}
      <span aria-hidden="true">/</span>
      <span aria-current="page">{{ product.title | escape }}</span>
    </nav>

    <div class="product__grid">
      {%- comment -%} Gallery {%- endcomment -%}
      <div class="product__media" data-fk-gallery>
        <div class="gallery__track" data-fk-gallery-track tabindex="0" aria-label="Product images, scroll for more">
          {%- for media in product.media -%}
            <div class="gallery__slide{% if media.media_type != 'image' %} gallery__slide--video{% endif %}" data-fk-slide>
              {%- case media.media_type -%}
                {%- when 'image' -%}
                  {%- liquid
                    if forloop.first
                      assign img_loading = 'eager'
                      assign img_priority = 'high'
                    else
                      assign img_loading = 'lazy'
                      assign img_priority = 'auto'
                    endif
                  -%}
                  {{
                    media
                    | image_url: width: 1400
                    | image_tag:
                      loading: img_loading,
                      fetchpriority: img_priority,
                      widths: '500, 750, 1000, 1400',
                      sizes: '(min-width: 990px) 55vw, 100vw',
                      alt: media.alt
                  }}
                {%- when 'video' -%}
                  {{ media | video_tag: controls: true, muted: true, playsinline: true, preload: 'none', image_size: '1400x' }}
                {%- when 'external_video' -%}
                  {{ media | external_video_tag: loading: 'lazy' }}
                {%- else -%}
                  {{ media | media_tag }}
              {%- endcase -%}
            </div>
          {%- else -%}
            <div class="gallery__slide gallery__slide--empty" data-fk-slide>
              {% render 'mat-outline' %}
            </div>
          {%- endfor -%}
        </div>
        <span class="gallery__tag chip chip--dark">
          {{- product.metafields.custom.drop_number.value | default: settings.drop_label | escape -}}
          {%- if product.metafields.custom.edition_number.value != blank %} · No. {{ product.metafields.custom.edition_number.value | escape }}{% endif -%}
        </span>
        {%- if media_count > 1 -%}
          <span class="gallery__count small" data-fk-gallery-count aria-hidden="true">1 / {{ media_count }}</span>
          <ul class="gallery__thumbs" aria-label="Choose image">
            {%- for media in product.media -%}
              <li>
                <button type="button" class="gallery__thumb" data-fk-thumb="{{ forloop.index0 }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="Show image {{ forloop.index }}{% if media.media_type != 'image' %} (video){% endif %}">
                  {{ media.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', width: 80, height: 80, alt: '' }}
                  {%- if media.media_type != 'image' -%}<span class="gallery__play">{% render 'icon', name: 'play' %}</span>{%- endif -%}
                </button>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      {%- comment -%} Buy box {%- endcomment -%}
      <div class="product__info">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'heading' -%}
              <div class="product__heading" {{ block.shopify_attributes }}>
                {%- assign theme_name = product.metafields.custom.theme.value | default: product.type -%}
                {%- if theme_name != blank -%}
                  <p class="eyebrow">{{ theme_name | escape }}</p>
                {%- endif -%}
                <h1 class="product__title">{{ product.title | escape }}</h1>
                {%- if block.settings.subtitle != blank -%}
                  <p class="product__subtitle">{{ block.settings.subtitle | escape }}</p>
                {%- endif -%}
                {%- assign rating = product.metafields.reviews.rating.value -%}
                {%- if rating != blank and product.metafields.reviews.rating_count.value > 0 -%}
                  <a href="#Reviews" class="product__rating small">
                    <span aria-hidden="true">★</span> {{ rating.rating | round: 1 }}
                    <span class="visually-hidden">out of {{ rating.scale_max }}</span>
                    · {{ product.metafields.reviews.rating_count.value }} reviews
                  </a>
                {%- endif -%}
              </div>

            {%- when 'price' -%}
              <div class="product__price stack" style="--gap: 0.4rem" {{ block.shopify_attributes }}>
                {% render 'price', target: variant, class: 'price--large', show_mrp_label: true %}
                <span class="small muted">{{ block.settings.tax_note | escape }}</span>
                {%- if saving > 0 and variant.available and variant.price > saving -%}
                  <span class="product__upi">Pay by UPI or card: <strong>{{ variant.price | minus: saving | money_without_trailing_zeros }}</strong></span>
                {%- endif -%}
              </div>

            {%- when 'stock' -%}
              <p class="product__stock {% if variant.available %}is-in{% else %}is-out{% endif %}" {{ block.shopify_attributes }}>
                <span class="product__stock-dot" aria-hidden="true"></span>
                {%- if variant.available -%}
                  {%- liquid
                    assign dispatch_token = '{' | append: 'dispatch' | append: '}'
                    assign in_stock_line = block.settings.in_stock | replace: dispatch_token, settings.dispatch_text
                  -%}
                  {{ in_stock_line | escape }}
                  {%- if block.settings.low_stock_threshold > 0 and variant.inventory_management == 'shopify' and variant.inventory_quantity > 0 and variant.inventory_quantity <= block.settings.low_stock_threshold %}
                    · only {{ variant.inventory_quantity }} left
                  {%- endif -%}
                {%- else -%}
                  {{ block.settings.sold_out | escape }}
                {%- endif -%}
              </p>

            {%- when 'editions' -%}
              {%- assign editions = block.settings.collection.products | default: collections.all.products -%}
              {%- if editions.size > 1 -%}
                <div class="editions" {{ block.shopify_attributes }}>
                  <p class="field__label" id="Editions-{{ block.id }}">{{ block.settings.label | escape }}</p>
                  <ul class="editions__list" aria-labelledby="Editions-{{ block.id }}">
                    {%- for edition in editions limit: 12 -%}
                      {%- assign short = edition.metafields.custom.short_name.value | default: edition.title | remove: ' Edition' -%}
                      <li>
                        <a
                          class="editions__link{% unless edition.available %} is-sold{% endunless %}"
                          href="{{ edition.url }}"
                          {% if edition.id == product.id %}
                            aria-current="true"
                          {% endif %}
                        >
                          {%- if edition.featured_image -%}
                            {{ edition.featured_image | image_url: width: 96 | image_tag: loading: 'lazy', width: 40, height: 40, alt: '' }}
                          {%- endif -%}
                          <span>{{ short | escape }}{% unless edition.available %}<span class="visually-hidden"> (sold out)</span>{% endunless %}</span>
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                </div>
              {%- endif -%}

            {%- when 'fit_check' -%}
              <div class="product__fit" {{ block.shopify_attributes }}>
                {% render 'fit-check',
                  id: block.id,
                  title: block.settings.title,
                  product: product,
                  fits_text: block.settings.fits_text,
                  gap_text: block.settings.gap_text,
                  ask_text: block.settings.ask_text,
                  fit_note: product.metafields.custom.fit_note.value
                %}
                <button type="button" class="link-button" data-fk-open="SizeGuide-{{ section.id }}">Size guide</button>
              </div>

            {%- when 'buy_buttons' -%}
              <div class="product__buy" {{ block.shopify_attributes }}>
                {%- if product.available -%}
                  {%- form 'product', product, id: form_id, class: 'product-form', data-fk-product-form: '' -%}
                    {%- unless product.has_only_default_variant -%}
                      <div class="field">
                        <label for="Variant-{{ section.id }}">{{ product.options.first | escape }}</label>
                        <select class="select" id="Variant-{{ section.id }}" name="id" onchange="window.location.search = '?variant=' + this.value">
                          {%- for v in product.variants -%}
                            <option value="{{ v.id }}" {% if v.id == variant.id %}selected{% endif %} {% unless v.available %}disabled{% endunless %}>
                              {{ v.title | escape }}{% unless v.available %} — sold out{% endunless %}
                            </option>
                          {%- endfor -%}
                        </select>
                      </div>
                    {%- else -%}
                      <input type="hidden" name="id" value="{{ variant.id }}">
                    {%- endunless -%}
                    <div class="product-form__row">
                      <div class="qty">
                        <button type="button" data-fk-step="-1" aria-label="Decrease quantity">−</button>
                        <label class="visually-hidden" for="Qty-{{ section.id }}">Quantity</label>
                        <input id="Qty-{{ section.id }}" type="number" name="quantity" min="1" max="10" value="1" inputmode="numeric">
                        <button type="button" data-fk-step="1" aria-label="Increase quantity">+</button>
                      </div>
                      <button type="submit" name="add" class="button product-form__add" data-fk-main-add>
                        Add to cart
                      </button>
                    </div>
                    {%- if block.settings.show_buy_now -%}
                      {{ form | payment_button }}
                    {%- endif -%}
                    <p class="form-message form-message--error" data-fk-form-error role="alert" hidden></p>
                  {%- endform -%}
                {%- else -%}
                  <div id="Restock" class="restock stack" style="--gap: 1rem" data-fk-main-add>
                    <p class="small">{{ block.settings.restock_text | escape }}</p>
                    {%- form 'contact', id: 'RestockForm', data-fk-signup: '' -%}
                      <input type="hidden" name="contact[tags]" value="restock-alert">
                      <input type="hidden" name="contact[body]" value="Restock alert: {{ product.title | escape }}">
                      {%- if form.posted_successfully? -%}
                        <p class="form-message form-message--success" role="status">Done. We'll message you when {{ product.title | escape }} is back.</p>
                      {%- else -%}
                        <div class="form-row">
                          <label class="visually-hidden" for="RestockEmail">Email</label>
                          <input class="input" id="RestockEmail" type="email" name="contact[email]" placeholder="Email" required autocomplete="email">
                          <label class="visually-hidden" for="RestockPhone">WhatsApp number (optional)</label>
                          <input class="input" id="RestockPhone" type="tel" name="contact[phone]" placeholder="WhatsApp number (optional)" autocomplete="tel">
                          <button type="submit" class="button">Notify me</button>
                        </div>
                        {%- if form.errors -%}
                          <p class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</p>
                        {%- endif -%}
                      {%- endif -%}
                    {%- endform -%}
                  </div>
                {%- endif -%}
              </div>

            {%- when 'offer' -%}
              {%- if block.settings.text != blank -%}
                <p class="product__offer" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
              {%- endif -%}

            {%- when 'details' -%}
              {%- liquid
                assign day = 86400
                assign now_s = 'now' | date: '%s' | plus: 0
                assign min_s = settings.delivery_min_days | times: day | plus: now_s
                assign max_s = settings.delivery_max_days | times: day | plus: now_s
                assign box = product.metafields.custom.set_contents.value | default: settings.set_contents
              -%}
              <dl class="details" {{ block.shopify_attributes }}>
                <div class="details__row">
                  <dt>{% render 'icon', name: 'set' %}In the box</dt>
                  <dd>{{ box | escape }}{% if block.settings.extra_box_item != blank %} · {{ block.settings.extra_box_item | escape }}{% endif %}</dd>
                </div>
                <div class="details__row">
                  <dt>{% render 'icon', name: 'ruler' %}Size</dt>
                  <dd>
                    Front {{ settings.front_size }} · Rear {{ settings.rear_size }}
                    <button type="button" class="link-button" data-fk-open="SizeGuide-{{ section.id }}">Check if it fits</button>
                  </dd>
                </div>
                <div class="details__row">
                  <dt>{% render 'icon', name: 'truck' %}Delivery</dt>
                  <dd>Estimated {{ min_s | date: '%b %-d' }} – {{ max_s | date: '%b %-d' }} <span class="muted">· dispatched in {{ settings.dispatch_text }}</span></dd>
                </div>
                {%- if settings.payment_text != blank -%}
                  <div class="details__row">
                    <dt>{% render 'icon', name: 'pay' %}Pay with</dt>
                    <dd>{{ settings.payment_text | escape }}</dd>
                  </div>
                {%- endif -%}
                {%- if settings.returns_text != blank -%}
                  <div class="details__row">
                    <dt>{% render 'icon', name: 'return' %}Returns</dt>
                    <dd>
                      {%- if shop.refund_policy -%}
                        <a href="{{ shop.refund_policy.url }}">{{ settings.returns_text | escape }}</a>
                      {%- else -%}
                        {{ settings.returns_text | escape }}
                      {%- endif -%}
                    </dd>
                  </div>
                {%- endif -%}
              </dl>

            {%- when 'text' -%}
              <div class="rte small" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

            {%- when 'accordion' -%}
              <details class="accordion" {{ block.shopify_attributes }}>
                <summary>{{ block.settings.heading | escape }}{% render 'icon', name: 'plus' %}</summary>
                <div class="accordion__body rte">
                  {%- if block.settings.source == 'description' -%}
                    {{ product.description }}
                  {%- else -%}
                    {{ block.settings.content }}
                  {%- endif -%}
                </div>
              </details>

            {%- when '@app' -%}
              {% render block %}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% render 'size-guide', id: section.id, product: product %}

{% schema %}
{
  "name": "Product",
  "class": "main-product-section",
  "blocks": [
    { "type": "@app" },
    {
      "type": "heading",
      "name": "Title",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Theme label comes from product metafield custom.theme, or the product type." },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "4-piece car floor mat set · Crystal velvet · Anti-skid" }
      ]
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "tax_note", "label": "Note under price", "default": "Inclusive of all taxes · Free delivery" },
        { "type": "paragraph", "content": "The UPI price shows when Theme settings › Delivery and payments › UPI / card saving is above 0." }
      ]
    },
    {
      "type": "stock",
      "name": "Stock line",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "in_stock", "label": "In stock text", "info": "{dispatch} becomes the dispatch time.", "default": "In stock · dispatched in {dispatch}" },
        { "type": "text", "id": "sold_out", "label": "Sold out text", "default": "Sold out — get a message when it's back" },
        { "type": "range", "id": "low_stock_threshold", "label": "Show 'only X left' at or below", "info": "0 turns it off. Uses real inventory only.", "min": 0, "max": 20, "step": 1, "default": 0 }
      ]
    },
    {
      "type": "editions",
      "name": "Edition switcher",
      "limit": 1,
      "settings": [
        { "type": "collection", "id": "collection", "label": "Editions collection", "info": "Defaults to all products." },
        { "type": "text", "id": "label", "label": "Label", "default": "Edition" }
      ]
    },
    {
      "type": "fit_check",
      "name": "Fit check",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Cars come from Content › Metaobjects › Car model (make, model, fit_status, note)." },
        { "type": "text", "id": "title", "label": "Title", "default": "Will it fit your car?" },
        { "type": "text", "id": "fits_text", "label": "Result when it fits", "info": "{car} becomes the selected car", "default": "Fits your {car}" },
        { "type": "text", "id": "gap_text", "label": "Result with a small gap", "default": "Fits your {car} with a small gap at the edges" },
        { "type": "text", "id": "ask_text", "label": "Result when not measured", "default": "We haven't measured the {car} yet — ask us and we'll check" }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "show_buy_now", "label": "Show Buy it now button", "default": true },
        { "type": "text", "id": "restock_text", "label": "Text when sold out", "default": "Sold out for now. Leave your email and we'll tell you first when it's back." }
      ]
    },
    {
      "type": "offer",
      "name": "Offer note",
      "settings": [
        { "type": "inline_richtext", "id": "text", "label": "Text", "default": "Two cars at home? <strong>Add a second edition</strong> for the other one." }
      ]
    },
    {
      "type": "details",
      "name": "Delivery and size info",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Sizes, delivery days, payment and returns lines come from Theme settings. 'In the box' uses product metafield custom.set_contents when set." },
        { "type": "text", "id": "extra_box_item", "label": "Extra item in the box", "info": "e.g. Edition card" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    },
    {
      "type": "accordion",
      "name": "Collapsible tab",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Specifications" },
        {
          "type": "select",
          "id": "source",
          "label": "Content",
          "options": [
            { "value": "custom", "label": "Text below" },
            { "value": "description", "label": "Product description" }
          ],
          "default": "custom"
        },
        { "type": "richtext", "id": "content", "label": "Text" }
      ]
    }
  ],
  "settings": []
}
{% endschema %}
