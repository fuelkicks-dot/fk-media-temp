        "q2": {
          "type": "question",
          "settings": {
            "question": "Is cash on delivery available?",
            "answer": "<p>Yes. Cash on delivery is available across India.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "How long does delivery take?",
            "answer": "<p>We dispatch within 24 hours, and delivery takes 5–7 days across India.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "What if it doesn't fit?",
            "answer": "<p>You can return a set within 7 days of delivery if the mats are unused, unwashed and in the original packaging. Message us on WhatsApp or email contactfuelkicks@gmail.com with your order number and we'll arrange the return. Once we've checked the set, we refund your original payment method; COD orders are refunded by UPI or bank transfer.</p><p>Damaged or wrong set? Send us photos within 48 hours of delivery and we'll replace it free.</p>"
          }
        },
        "q5": {
          "type": "question",
          "settings": {
            "question": "How do I clean the mats?",
            "answer": "<p>They're pressure washable. Lift the mats out, wash them with a pressure washer or hose, let them dry fully and lay them back in.</p>"
          }
        },
        "q6": {
          "type": "question",
          "settings": {
            "question": "Are the designs original?",
            "answer": "<p>Fuel Kicks brought these designs to car mats. Every edition is printed in small runs, and new ones arrive with each drop.</p>"
          }
        }
